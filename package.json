{
  "name": "inixpoint",
  "version": "0.1.0",
  "private": true,
  "description": "InixPoint - Browser-based Interactive Presentation & Classroom Quiz Platform",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev:server": "npm --workspace=server run dev",
    "dev:client": "npm --workspace=client run dev",
    "dev": "npm --workspace=server run dev",
    "build": "npm --workspaces run build",
    "start": "npm --workspace=server run start"
  },
  "keywords": [
    "classroom-quiz",
    "interactive-presentation",
    "edtech",
    "socketio",
    "react"
  ],
  "author": "Aqil Wahid",
  "license": "MIT"
}
