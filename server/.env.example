# Environment variables for InixPoint Server

# Port
PORT=4000

# Vercel Client URL (update for production)
CLIENT_URL=http://localhost:3000

# Database (sqlite is default, kept in memory for stateless Railway deployments)
# For persistence, implement cloud DB integration later
DB_PATH=./data/inixpoint.db

# Session/Token settings (minutes)
SESSION_GRACE_PERIOD_MIN=5

# Load test settings (optional)
LOAD_TEST_PARTICIPANTS=200
LOAD_TEST_DURATION_SEC=30
